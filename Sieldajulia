-- Salvar configurações originais
local saved = {}
local active = {}

local function save(obj, property, value)
    if not saved[obj] then
        saved[obj] = {}
    end

    if saved[obj][property] == nil then
        local ok, original = pcall(function()
            return obj[property]
        end)

        if ok then
            saved[obj][property] = original
        end
    end

    pcall(function()
        obj[property] = value
    end)
end

local function restoreAll()
    for obj, properties in pairs(saved) do
        if obj and obj.Parent then
            for property, value in pairs(properties) do
                pcall(function()
                    obj[property] = value
                end)
            end
        end
    end

    table.clear(saved)
    table.clear(active)
end

